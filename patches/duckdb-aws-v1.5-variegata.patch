\ No newline at end of file
+if (EMSCRIPTEN)
+    # For WebAssembly builds the loadable extension is produced by a plain
+    # `emcc <archive> -o <ext>.wasm -sSIDE_MODULE=2 ${LINKED_LIBS}` re-link,
