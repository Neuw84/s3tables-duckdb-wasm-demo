+    # Paths are relative to build/<platform>/extension/aws/, where the
+    # POST_BUILD emcc command runs.
+    set(VCPKG_WASM_LIB_DIR "../../vcpkg_installed/wasm32-emscripten/lib")
+    string(JOIN " " AWS_WASM_LINKED_LIBS
